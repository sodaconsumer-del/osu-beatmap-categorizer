<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>realm-reader</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Realm ships a native (non-.NET) library alongside its managed DLL.
         Without this, single-file publish leaves the native library behind,
         and the first call into Realm throws a TypeInitializationException
         on SharedRealmHandle (the managed wrapper can't find its native
         counterpart). This flag makes the single-file bundle include native
         libraries too, so they get extracted alongside the exe at runtime. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Realm" Version="20.1.0" />
  </ItemGroup>

</Project>
