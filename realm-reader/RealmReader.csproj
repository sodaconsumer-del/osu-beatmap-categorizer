<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>realm-reader</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <!-- Deliberately NOT using PublishSingleFile: Realm's native interop
         library has documented compatibility issues with single-file
         publishing (the native library either isn't extracted correctly at
         runtime or fails to load), which is exactly the
         'TypeInitializationException on SharedRealmHandle' failure this
         caused in testing. Publishing as a normal folder (exe + its
         supporting managed/native DLLs sitting together) is the
         conventional, well-supported way to deploy a .NET app with native
         dependencies, and avoids that whole class of problem. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Realm" Version="20.1.0" />
  </ItemGroup>

</Project>
